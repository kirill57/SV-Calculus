<project ptx-version="2">
  <targets>
    <target name="web" format="html"/>
    <target name="print" format="pdf"><stringparams latex.preamble.late="\titleformat{\chapter}[display]{\divisionfont\huge\bfseries\raggedright}{\divisionnameptx\space\thechapter}{20pt}{\Huge\hyphenpenalty=10000\exhyphenpenalty=10000 #1}[{\Large\authorsptx}]"/></target>
  </targets>
</project>
