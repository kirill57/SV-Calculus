<?xml version="1.0" encoding="UTF-8"?>
<docinfo xmlns:xi="http://www.w3.org/2001/XInclude">
  <document-id>svcalcbook</document-id>
  <directories external="../assets"/>

  <!-- Expand this list from the actual LaTeX source inventory. -->
  <macros>
    \newcommand{\R}{\mathbb{R}}
    \newcommand{\Q}{\mathbb{Q}}
    \newcommand{\Z}{\mathbb{Z}}
    \newcommand{\N}{\mathbb{N}}
    \newcommand{\Cplx}{\mathbb{C}}
    \newcommand{\abs}[1]{\left\lvert #1 \right\rvert}
    \newcommand{\norm}[1]{\left\lVert #1 \right\rVert}
  </macros>

  <!-- Preamble for planar TikZ/PGFPlots only. True 3D must use Asymptote. -->
  <latex-image-preamble>
    \usepackage{amsmath,amssymb}
    \usepackage[dvipsnames]{xcolor}
    \usepackage{tikz}
    \usepackage{pgfplots}
    \pgfplotsset{
      compat=1.18,
      every axis/.append style={
        clip=false,
        tick label style={font=\small},
        label style={font=\small},
      }
    }
    \usepgfplotslibrary{fillbetween,colormaps}
    \usetikzlibrary{arrows,arrows.meta,calc,decorations,decorations.markings}
    \usetikzlibrary{decorations.pathreplacing,intersections,matrix,patterns}
    \usetikzlibrary{positioning,shadows,shapes}
  </latex-image-preamble>
</docinfo>
