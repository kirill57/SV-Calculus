<!-- CONVERTED — VISUALLY VERIFIED --><section xml:id="sec-a-6-practice-problems">
  <title>Practice problems</title>

  <subsection xml:id="subsec-sec-a-6-practice-problems-factoring-and-completing-the-square">
    <title>Factoring and completing the square</title>

    <p><ol>
      <li>
        <p>Factor <m>x^2+7x+12</m>.</p>
      </li>
      <li>
        <p>Factor <m>2x^2-5x-3</m>.</p>
      </li>
      <li>
        <p>Factor <m>x^3-8</m>.</p>
      </li>
      <li>
        <p>Complete the square:</p>
          <p><me>x^2+10x+13.</me></p>
      </li>
      <li>
        <p>Complete the square:</p>
          <p><me>3x^2-12x+7.</me></p>
      </li>
      <li>
        <p>Solve:</p>
          <p><me>x^2-4x-5=0.</me></p>
      </li>
    </ol></p>
  </subsection>

  <subsection xml:id="subsec-sec-a-6-practice-problems-rational-expressions">
    <title>Rational expressions</title>

    <p><ol>
      <li>
        <p>Simplify:</p>
          <p><me>\frac{x^2-4}{x-2}.</me></p>
        <p>State the restriction.</p>
      </li>
      <li>
        <p>Simplify:</p>
          <p><me>\frac{x^2+3x+2}{x^2-1}.</me></p>
        <p>State the restrictions.</p>
      </li>
      <li>
        <p>Simplify:</p>
          <p><me>\frac{1}{x}+\frac{1}{x+2}.</me></p>
      </li>
      <li>
        <p>Simplify:</p>
          <p><me>\frac{\frac1{x+h}-\frac1x}{h},
\qquad h\neq0.</me></p>
      </li>
      <li>
        <p>Rationalize:</p>
          <p><me>\frac{\sqrt{x+9}-3}{x}.</me></p>
      </li>
    </ol></p>
  </subsection>

  <subsection xml:id="subsec-sec-a-6-practice-problems-exponents-and-radicals">
    <title>Exponents and radicals</title>

    <p><ol>
      <li>
        <p>Rewrite as a power of <m>x</m>:</p>
          <p><me>\frac{1}{x^3\sqrt{x}}.</me></p>
      </li>
      <li>
        <p>Simplify:</p>
          <p><me>x^{2/3}x^{5/3}.</me></p>
      </li>
      <li>
        <p>Rewrite using radicals:</p>
          <p><me>x^{3/2}.</me></p>
      </li>
      <li>
        <p>Simplify:</p>
          <p><me>\left(x^{-2}\right)^3.</me></p>
      </li>
      <li>
        <p>State the real domain of</p>
          <p><me>\frac{1}{\sqrt{x-4}}.</me></p>
      </li>
    </ol></p>
  </subsection>

  <subsection xml:id="subsec-sec-a-6-practice-problems-inequalities-and-absolute-values">
    <title>Inequalities and absolute values</title>

    <p><ol>
      <li>
        <p>Solve:</p>
          <p><me>5-2x\le 11.</me></p>
      </li>
      <li>
        <p>Solve:</p>
          <p><me>x^2+x-6&lt;0.</me></p>
      </li>
      <li>
        <p>Solve:</p>
          <p><me>\frac{x-4}{x+1}&gt;0.</me></p>
      </li>
      <li>
        <p>Solve:</p>
          <p><me>|x-3|&lt;0.5.</me></p>
      </li>
      <li>
        <p>Solve:</p>
          <p><me>|4x-1|\ge 7.</me></p>
      </li>
    </ol></p>
  </subsection>

  <subsection xml:id="subsec-sec-a-6-practice-problems-sigma-notation">
    <title>Sigma notation</title>

    <p><ol>
      <li>
        <p>Expand:</p>
          <p><me>\sum_{k=1}^{5}(k^2+1).</me></p>
      </li>
      <li>
        <p>Compute:</p>
          <p><me>\sum_{k=1}^{20} k.</me></p>
      </li>
      <li>
        <p>Compute:</p>
          <p><me>\sum_{k=1}^{6} k^2.</me></p>
      </li>
      <li>
        <p>Compute:</p>
          <p><me>\sum_{k=0}^{5} 2^k.</me></p>
      </li>
      <li>
        <p>Write the right Riemann sum for <m>f(x)=x^3</m> on <m>[0,1]</m> using <m>n</m> equal
subintervals.</p>
      </li>
      <li>
        <p>Simplify the sum from the previous problem as much as possible using a sum
formula.</p>
      </li>
    </ol></p>
  </subsection>

  <subsection xml:id="ans-appendix-a-practice">
    <title>Answers to Appendix A practice problems</title>


  <paragraphs xml:id="subsec-sec-a-6-practice-problems-factoring-and-completing-the-square-2">
    <title>Factoring and completing the square</title>

    <p><ol>
      <li>
          <p><me>x^2+7x+12=(x+3)(x+4).</me></p>
      </li>
      <li>
          <p><me>2x^2-5x-3=(2x+1)(x-3).</me></p>
      </li>
      <li>
          <p><me>x^3-8=(x-2)(x^2+2x+4).</me></p>
      </li>
      <li>
          <p><me>x^2+10x+13=(x+5)^2-12.</me></p>
      </li>
      <li>
          <p><me>3x^2-12x+7=3(x-2)^2-5.</me></p>
      </li>
      <li>
          <p><me>x^2-4x-5=(x-5)(x+1),</me></p>
        <p>so</p>
          <p><me>x=5
\qquad\text{or}\qquad
x=-1.</me></p>
      </li>
    </ol></p>
  </paragraphs>

  <paragraphs xml:id="subsec-sec-a-6-practice-problems-rational-expressions-2">
    <title>Rational expressions</title>

    <p><ol>
      <li>
          <p><me>\frac{x^2-4}{x-2}
=
\frac{(x-2)(x+2)}{x-2}
=
x+2,
\qquad x\neq2.</me></p>
      </li>
      <li>
          <p><me>\frac{x^2+3x+2}{x^2-1}
=
\frac{(x+1)(x+2)}{(x-1)(x+1)}
=
\frac{x+2}{x-1},
\qquad x\neq -1,1.</me></p>
      </li>
      <li>
          <p><me>\frac{1}{x}+\frac{1}{x+2}
=
\frac{x+2+x}{x(x+2)}
=
\frac{2x+2}{x(x+2)}
=
\frac{2(x+1)}{x(x+2)}.</me></p>
      </li>
      <li>
          <p><me>\frac{\frac1{x+h}-\frac1x}{h}
=
\frac{\frac{x-(x+h)}{x(x+h)}}{h}
=
\frac{-h}{x(x+h)h}
=
-\frac1{x(x+h)}.</me></p>
      </li>
      <li>
          <p><me>\frac{\sqrt{x+9}-3}{x}
\cdot
\frac{\sqrt{x+9}+3}{\sqrt{x+9}+3}
=
\frac{x}{x(\sqrt{x+9}+3)}
=
\frac1{\sqrt{x+9}+3},</me></p>
        <p>with the original restrictions <m>x\ge -9</m> and <m>x\neq0</m>.</p>
      </li>
    </ol></p>
  </paragraphs>

  <paragraphs xml:id="subsec-sec-a-6-practice-problems-exponents-and-radicals-2">
    <title>Exponents and radicals</title>

    <p><ol>
      <li>
          <p><me>\frac{1}{x^3\sqrt{x}}=x^{-7/2}.</me></p>
      </li>
      <li>
          <p><me>x^{2/3}x^{5/3}=x^{7/3}.</me></p>
      </li>
      <li>
          <p><me>x^{3/2}=x\sqrt{x}.</me></p>
      </li>
      <li>
          <p><me>(x^{-2})^3=x^{-6}=\frac1{x^6}.</me></p>
      </li>
      <li>
          <p><me>\frac1{\sqrt{x-4}}</me></p>
        <p>requires</p>
          <p><me>x-4&gt;0,</me></p>
        <p>so the domain is</p>
          <p><me>(4,\infty).</me></p>
      </li>
    </ol></p>
  </paragraphs>

  <paragraphs xml:id="subsec-sec-a-6-practice-problems-inequalities-and-absolute-values-2">
    <title>Inequalities and absolute values</title>

    <p><ol>
      <li>
          <p><me>5-2x\le11</me></p>
        <p>gives</p>
          <p><me>-2x\le6.</me></p>
        <p>Divide by <m>-2</m> and reverse the inequality:</p>
          <p><me>x\ge -3.</me></p>
      </li>
      <li>
          <p><me>x^2+x-6=(x+3)(x-2).</me></p>
        <p>The product is negative between the roots, so</p>
          <p><me>-3&lt;x&lt;2.</me></p>
      </li>
      <li>
        <p>The critical numbers are <m>-1</m> and <m>4</m>.  The quotient is positive when numerator and
denominator have the same sign, so</p>
          <p><me>(-\infty,-1)\cup(4,\infty).</me></p>
      </li>
      <li>
          <p><me>|x-3|&lt;0.5</me></p>
        <p>means</p>
          <p><me>2.5&lt;x&lt;3.5.</me></p>
      </li>
      <li>
          <p><me>|4x-1|\ge7</me></p>
        <p>means</p>
          <p><me>4x-1\le -7
\qquad\text{or}\qquad
4x-1\ge7.</me></p>
        <p>Thus</p>
          <p><me>x\le -\frac32
\qquad\text{or}\qquad
x\ge2.</me></p>
      </li>
    </ol></p>
  </paragraphs>

  <paragraphs xml:id="subsec-sec-a-6-practice-problems-sigma-notation-2">
    <title>Sigma notation</title>

    <p><ol>
      <li>
          <p><me>\sum_{k=1}^{5}(k^2+1)
=
(1^2+1)+(2^2+1)+(3^2+1)+(4^2+1)+(5^2+1).</me></p>
      </li>
      <li>
          <p><me>\sum_{k=1}^{20}k=\frac{20(21)}2=210.</me></p>
      </li>
      <li>
          <p><me>\sum_{k=1}^{6}k^2=\frac{6(7)(13)}6=91.</me></p>
      </li>
      <li>
          <p><me>\sum_{k=0}^{5}2^k=\frac{1-2^6}{1-2}=63.</me></p>
      </li>
      <li>
        <p>On <m>[0,1]</m>,</p>
          <p><me>\Delta x=\frac1n,
\qquad
x_k=\frac{k}{n}.</me></p>
        <p>The right Riemann sum is</p>
          <p><me>\sum_{k=1}^{n}\left(\frac{k}{n}\right)^3\frac1n.</me></p>
      </li>
      <li>
          <p><me>\sum_{k=1}^{n}\left(\frac{k}{n}\right)^3\frac1n
=
\frac1{n^4}\sum_{k=1}^{n}k^3.</me></p>
        <p>Using</p>
          <p><me>\sum_{k=1}^{n}k^3=\left(\frac{n(n+1)}2\right)^2,</me></p>
        <p>we get</p>
          <p><me>\frac1{n^4}\left(\frac{n(n+1)}2\right)^2
=
\frac{(n+1)^2}{4n^2}.</me></p>
      </li>
    </ol></p>
  </paragraphs>

</subsection>

