      </li>
      <li>
        <p>Rewrite without powers:</p>
          <md>\cos^2 x.</md>
      </li>
      <li>
        <p>Rewrite as a sum:</p>
          <md>\sin(5x)\cos(2x).</md>
      </li>
      <li>
        <p>Rewrite as a sum:</p>
          <md>\cos(4x)\cos(x).</md>
      </li>
    </ol>
