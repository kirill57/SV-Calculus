  <xi:include href="sections/sec-c-3-addition-formulas.xml"/>
  <xi:include href="sections/sec-c-4-inverse-trigonometric-functions.xml"/>
  <xi:include href="sections/sec-c-5-trigonometric-equations.xml"/>
  <xi:include href="sections/sec-c-6-practice-problems.xml"/>

</appendix>
